<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.library.DashboardController" styleClass="app-background">
    <left>
        <VBox prefWidth="230" spacing="8" styleClass="sidebar">
            <Label text="LIBRARY DESK" styleClass="sidebar-brand" />
            <Label text="Management System" styleClass="sidebar-subtitle" />
            <VBox spacing="4" VBox.vgrow="ALWAYS" styleClass="navigation-box">
                <Button text="Dashboard" onAction="#showDashboard" styleClass="nav-button" />
                <Button text="Add Book" onAction="#showAddBook" styleClass="nav-button" />
                <Button text="Add Member" onAction="#showAddMember" styleClass="nav-button" />
                <Button text="Manage Members" onAction="#showMembers" styleClass="nav-button" />
                <Button text="Issue Book" onAction="#showIssueBook" styleClass="nav-button" />
                <Button text="Return Book" onAction="#showReturnBook" styleClass="nav-button" />
                <Button text="Borrowing History" onAction="#showHistory" styleClass="nav-button" />
            </VBox>
            <Button text="Logout" onAction="#logout" styleClass="logout-button" />
        </VBox>
    </left>
    <center>
        <StackPane fx:id="contentArea" styleClass="content-area" />
    </center>
</BorderPane>
